# PrimeSoul AI Environment Configuration

# Server Port
PORT=3001

# AI Provider: "mock" (₹0 default, offline ready), "gemini", "ollama", "openai"
AI_PROVIDER=mock

# Gemini API Key (Optional - for live Google Gemini Free Tier inference)
GEMINI_API_KEY=

# Ollama Endpoint (Optional - for local LLMs)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b

# OpenAI Compatible Endpoint (Optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
